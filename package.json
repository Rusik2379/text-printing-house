{
  "name": "tekst-printing-house",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "prices:sync": "node scripts/sync-content-prices.mjs",
    "test:admin": "node --test tests/admin.test.mjs tests/admin-ui.test.mjs",
    "test:orders": "node --test tests/orders.test.mjs tests/orders-ui.test.mjs tests/admin-orders.test.mjs",
    "test:regression": "node scripts/test-regression.mjs",
    "test:redirects": "node --test tests/legacy-redirects.test.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "build": "node scripts/build-release.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "audit:unused": "node scripts/audit-unused.mjs",
    "format": "prettier --write \"*.{js,css,mjs}\" \".server/**/*.{mjs,js,css}\" \"scripts/*.mjs\" \"tests/*.mjs\" \"*.md\" \"docs/*.md\" \"deploy/*.md\" \"infrastructure/**/*.{md,mjs}\"",
    "format:check": "prettier --check \"*.{js,css,mjs}\" \".server/**/*.{mjs,js,css}\" \"scripts/*.mjs\" \"tests/*.mjs\" \"*.md\" \"docs/*.md\" \"deploy/*.md\" \"infrastructure/**/*.{md,mjs}\"",
    "check": "npm run lint && npm run format:check && npm run check:pages && npm run check:seo && npm run test:regression && npm run build && npm run check:runtime",
    "build:home": "node scripts/prerender-homepage.mjs",
    "lint": "eslint .",
    "assets:version": "python scripts/version-resources.py"
  },
  "devDependencies": {
    "css-tree": "3.2.1",
    "eslint": "10.14.0",
    "jsdom": "30.1.2",
    "prettier": "3.6.2"
  }
}
